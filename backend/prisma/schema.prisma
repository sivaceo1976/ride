// Prisma Schema for Real-Time Event-Driven Ride Hailing Platform
// Database: PostgreSQL with PostGIS extension

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum VehicleClass {
  BIKE
  SEDAN
  SUV
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_PICKUP
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone          String    @unique @db.VarChar(20)
  name           String    @db.VarChar(100)
  role           UserRole  @default(RIDER)
  rating         Decimal   @default(5.00) @db.Decimal(3, 2)
  walletBalance  Decimal   @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  vehicles       Vehicle[]
  riderRides     Ride[]    @relation("RiderRides")
  driverRides    Ride[]    @relation("DriverRides")
  telemetries    DriverTelemetry[]

  @@index([phone], name: "idx_users_phone")
  @@index([role], name: "idx_users_role")
  @@map("users")
}

model Vehicle {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId     String        @map("driver_id") @db.Uuid
  make         String        @db.VarChar(50)
  model        String        @db.VarChar(50)
  year         Int           @default(2023)
  licensePlate String        @unique @map("license_plate") @db.VarChar(20)
  class        VehicleClass  @default(SEDAN)
  color        String        @db.VarChar(30)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  driver       User          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId], name: "idx_vehicles_driver_id")
  @@index([class], name: "idx_vehicles_class")
  @@map("vehicles")
}

model Ride {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  riderId              String      @map("rider_id") @db.Uuid
  driverId             String?     @map("driver_id") @db.Uuid
  status               RideStatus  @default(REQUESTED)
  pickupAddress        String      @map("pickup_address") @db.Text
  // PostGIS geometry: geometry(Point, 4326)
  pickupGeom           Unsupported("geometry(Point, 4326)") @map("pickup_geom")
  dropoffAddress       String      @map("dropoff_address") @db.Text
  // PostGIS geometry: geometry(Point, 4326)
  dropoffGeom          Unsupported("geometry(Point, 4326)") @map("dropoff_geom")
  fareBreakdown        Json        @map("fare_breakdown") @db.JsonB
  otp                  String      @db.VarChar(4)
  surgeMultiplier      Decimal     @default(1.00) @map("surge_multiplier") @db.Decimal(3, 2)
  estimatedDistanceKm  Decimal     @map("estimated_distance_km") @db.Decimal(6, 2)
  estimatedDurationMin Decimal     @map("estimated_duration_min") @db.Decimal(6, 2)
  cancellationReason   String?     @map("cancellation_reason") @db.Text
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedAt           DateTime?   @map("accepted_at") @db.Timestamptz(6)
  arrivedAt            DateTime?   @map("arrived_at") @db.Timestamptz(6)
  startedAt            DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?   @map("completed_at") @db.Timestamptz(6)

  // Relations
  rider                User        @relation("RiderRides", fields: [riderId], references: [id], onDelete: Restrict)
  driver               User?       @relation("DriverRides", fields: [driverId], references: [id], onDelete: SetNull)

  @@index([riderId], name: "idx_rides_rider_id")
  @@index([driverId], name: "idx_rides_driver_id")
  @@index([status], name: "idx_rides_status")
  @@index([createdAt], name: "idx_rides_created_at")
  @@map("rides")
}

// driver_telemetry is partitioned by week on recorded_at
model DriverTelemetry {
  id         BigInt   @default(autoincrement())
  driverId   String   @map("driver_id") @db.Uuid
  // PostGIS geometry: geometry(Point, 4326)
  location   Unsupported("geometry(Point, 4326)")
  bearing    Decimal  @default(0.00) @db.Decimal(5, 2)
  speed      Decimal  @default(0.00) @db.Decimal(5, 2)
  h3Index    String   @map("h3_index") @db.VarChar(15)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  // Relations
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([recordedAt, id])
  @@index([driverId, recordedAt(sort: Desc)], name: "idx_telemetry_driver_recorded")
  @@index([h3Index], name: "idx_telemetry_h3")
  @@map("driver_telemetry")
}
